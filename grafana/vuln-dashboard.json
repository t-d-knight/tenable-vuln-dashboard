{
  "__inputs": [
    {
      "name": "DS_POSTGRESQL",
      "label": "PostgreSQL",
      "description": "Postgres datasource pointing at the tenable_trends database",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "postgres",
      "name": "PostgreSQL",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "row",
      "name": "Row",
      "version": ""
    }
  ],
  "id": null,
  "uid": "vuln-mgmt-core",
  "title": "Vulnerability Management",
  "description": "Site/severity trending, SLA compliance, CISA KEV exposure, worst-devices hit list, and MTTR tracking against the vuln_findings core. Companion to Vuln-Analysis-Current.pbix, not a replacement.",
  "tags": [
    "vuln-management",
    "tenable",
    "kev",
    "mttr"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1h",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1h",
      "12h",
      "1d"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "site",
        "type": "query",
        "label": "Site",
        "datasource": {
          "type": "postgres",
          "uid": "${DS_POSTGRESQL}"
        },
        "query": "SELECT DISTINCT site_label FROM dim_site ORDER BY site_label",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Executive Summary",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Open Findings",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"Open Findings\" FROM fact_vuln_findings_current WHERE site_label IN ($site)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Critical + High Open",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"Critical + High\" FROM fact_vuln_findings_current WHERE site_label IN ($site) AND severity IN ('critical','high')"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SLA Breach Rate",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE sla_breach) / NULLIF(count(*),0), 1) AS \"SLA Breach Rate\" FROM fact_vuln_findings_current WHERE site_label IN ($site)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "% Findings with Active KEV",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE has_kev) / NULLIF(count(*),0), 1) AS \"Active KEV %\" FROM fact_vuln_findings_current WHERE site_label IN ($site)"
        }
      ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Remote + No-Auth Crit/High Open",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"Remote+NoAuth Crit/High\" FROM fact_vuln_findings_current WHERE site_label IN ($site) AND severity IN ('critical','high') AND is_remote_no_auth"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Remote + No-Auth Crit/High Trend",
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 18,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Remote Critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Remote High"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT snapshot_date::timestamp AS time, sum(remote_crit) AS \"Remote Critical\", sum(remote_high) AS \"Remote High\" FROM daily_site_metrics WHERE site_label IN ($site) AND snapshot_date::date BETWEEN '${__from:date}' AND '${__to:date}' GROUP BY snapshot_date ORDER BY time"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Open Findings by Severity",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "High"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Medium"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Low"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT snapshot_date::timestamp AS time, sum(crit) AS \"Critical\", sum(high) AS \"High\", sum(medium) AS \"Medium\", sum(low) AS \"Low\" FROM daily_site_metrics WHERE site_label IN ($site) AND snapshot_date::date BETWEEN '${__from:date}' AND '${__to:date}' GROUP BY snapshot_date ORDER BY time"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Vulns Remediated per Day",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT snapshot_date::timestamp AS time, sum(fixed_count) AS \"Remediated\" FROM daily_mttr_metrics WHERE site_label IN ($site) AND snapshot_date::date BETWEEN '${__from:date}' AND '${__to:date}' GROUP BY snapshot_date ORDER BY time"
        }
      ]
    },
    {
      "id": 106,
      "type": "row",
      "title": "Trend (7-Day Change)",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Open Findings \u0394 (7d)",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 999999999,
                "result": {
                  "text": "+${__value.text}"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (\n  SELECT max(snapshot_date) AS d FROM daily_site_metrics\n),\nhist AS (\n  SELECT max(snapshot_date) AS d FROM daily_site_metrics, latest\n  WHERE snapshot_date::date <= latest.d::date - 7\n),\nnow_v AS (\n  SELECT coalesce(sum(total),0) AS v FROM daily_site_metrics, latest\n  WHERE site_label IN ($site) AND snapshot_date = latest.d\n),\nthen_v AS (\n  SELECT coalesce(sum(total),0) AS v FROM daily_site_metrics, hist\n  WHERE site_label IN ($site) AND snapshot_date = hist.d\n)\nSELECT (now_v.v - then_v.v) AS delta FROM now_v, then_v;"
        }
      ]
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Crit + High \u0394 (7d)",
      "gridPos": {
        "x": 6,
        "y": 28,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 999999999,
                "result": {
                  "text": "+${__value.text}"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (\n  SELECT max(snapshot_date) AS d FROM daily_site_metrics\n),\nhist AS (\n  SELECT max(snapshot_date) AS d FROM daily_site_metrics, latest\n  WHERE snapshot_date::date <= latest.d::date - 7\n),\nnow_v AS (\n  SELECT coalesce(sum(crit)+sum(high),0) AS v FROM daily_site_metrics, latest\n  WHERE site_label IN ($site) AND snapshot_date = latest.d\n),\nthen_v AS (\n  SELECT coalesce(sum(crit)+sum(high),0) AS v FROM daily_site_metrics, hist\n  WHERE site_label IN ($site) AND snapshot_date = hist.d\n)\nSELECT (now_v.v - then_v.v) AS delta FROM now_v, then_v;"
        }
      ]
    },
    {
      "id": 20,
      "type": "stat",
      "title": "SLA Breach Rate \u0394 (7d, pts)",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 999999999,
                "result": {
                  "text": "+${__value.text}"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (\n  SELECT max(snapshot_date) AS d FROM daily_sla_metrics\n),\nhist AS (\n  SELECT max(snapshot_date) AS d FROM daily_sla_metrics, latest\n  WHERE snapshot_date::date <= latest.d::date - 7\n),\nnow_v AS (\n  SELECT round(100.0*sum(sla_breaches)/NULLIF(sum(total_vulns),0),1) AS v FROM daily_sla_metrics, latest\n  WHERE site_label IN ($site) AND snapshot_date = latest.d\n),\nthen_v AS (\n  SELECT round(100.0*sum(sla_breaches)/NULLIF(sum(total_vulns),0),1) AS v FROM daily_sla_metrics, hist\n  WHERE site_label IN ($site) AND snapshot_date = hist.d\n)\nSELECT (now_v.v - then_v.v) AS delta FROM now_v, then_v;"
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Active KEV % \u0394 (7d, pts)",
      "gridPos": {
        "x": 18,
        "y": 28,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 999999999,
                "result": {
                  "text": "+${__value.text}"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (\n  SELECT max(snapshot_date) AS d FROM daily_kev_metrics\n),\nhist AS (\n  SELECT max(snapshot_date) AS d FROM daily_kev_metrics, latest\n  WHERE snapshot_date::date <= latest.d::date - 7\n),\nnow_v AS (\n  SELECT round(100.0*sum(kev_open_total)/NULLIF(sum(kev_open_total)+sum(non_kev_open_total),0),1) AS v FROM daily_kev_metrics, latest\n  WHERE site_label IN ($site) AND snapshot_date = latest.d\n),\nthen_v AS (\n  SELECT round(100.0*sum(kev_open_total)/NULLIF(sum(kev_open_total)+sum(non_kev_open_total),0),1) AS v FROM daily_kev_metrics, hist\n  WHERE site_label IN ($site) AND snapshot_date = hist.d\n)\nSELECT (now_v.v - then_v.v) AS delta FROM now_v, then_v;"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "SLA Compliance",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 17,
      "type": "table",
      "title": "Current SLA Policy",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT severity AS \"Severity\", threshold_days AS \"SLA (days)\", updated_at AS \"Last Changed\" FROM sla_policy ORDER BY CASE severity WHEN 'critical' THEN 1 WHEN 'high' THEN 2 WHEN 'medium' THEN 3 ELSE 4 END"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "SLA Breach by Site & Risk (latest snapshot)",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT site_label AS \"Site\", risk AS \"Risk\", total_vulns AS \"Total\", sla_breaches AS \"Breaches\", round(100.0 * sla_breaches / NULLIF(total_vulns,0), 1) AS \"Breach Rate %\" FROM daily_sla_metrics WHERE site_label IN ($site) AND snapshot_date = (SELECT max(snapshot_date) FROM daily_sla_metrics) ORDER BY \"Breach Rate %\" DESC"
