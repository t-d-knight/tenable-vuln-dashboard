# config.yaml.example
# Copy this file to config.yaml and fill in your values.
# config.yaml is listed in .gitignore -- it typically contains real site/
# facility names, so don't commit it. Credentials go in secrets.yaml instead
# (see secrets.yaml.example).

tenable:
  base_url: "https://cloud.tenable.com"
  # access_key / secret_key are loaded from secrets.yaml

crowdstrike:
  base_url: "https://api.us-2.crowdstrike.com"
  # client_id / client_secret are loaded from secrets.yaml (only needed if
  # you're using CrowdStrike asset collection)

# Enabled vulnerability data sources. Each "type" must have a matching
# adapter in vendors/ (see vendors/__init__.py's ADAPTERS registry).
# Today only "tenable" exists; a future CrowdStrike Falcon Exposure
# Management or Intune adapter would add another entry here.
sources:
  - name: tenable
    type: tenable
    enabled: true

reporting:
  days_last_seen: 30
  vuln_published_older_than_days: 30
  # true  = only flag remote/no-auth vulns that also have a known exploit (lower noise, recommended)
  # false = flag all network-accessible, no-auth vulns regardless of exploit availability (broader coverage)
  require_exploit_for_remote_no_auth: true
  retention_days: 540
  # How long FIXED-state rows live in vuln_findings before maintenance.sh
  # prunes them. Separate from retention_days (which governs the daily_*
  # aggregate snapshot tables).
  findings_retention_days: 180
  # SLA remediation windows in days, per severity. Synced into the
  # sla_policy table (single source of truth for the SLA breach/MTTR
  # compliance calculations AND the "Current SLA Policy" Grafana panel)
  # every time db_schema.ensure_schema() runs. Changing this only affects
  # today onward -- past daily_sla_metrics/daily_mttr_metrics rows keep
  # whatever policy was in effect when they were computed.
  sla_days:
    critical: 2
    high: 14
    medium: 30
    low: 60

sites:
  - key: "Alpha-Site"
    label: "Site A"
  - key: "Bravo-Site"
    label: "Site B"
  # Add your own site tag keys and labels here

ungrouped_label: "Ungrouped"

tags:
  site_category: "Sites"
  asset_type_category: "AssetType"
  internet_values: ["InternetFacing"]
  server_values: ["Server"]
  workstation_values: ["Workstation"]

database:
  engine: "postgres"
  host: "127.0.0.1"
  port: 5432
  name: "tenable_trends"
  # user / password will be loaded from secrets.yaml

# Path to your secrets file (relative to this config file)
secrets_file: "secrets.yaml"
